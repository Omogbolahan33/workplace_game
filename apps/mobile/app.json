{
  "expo": {
    "name": "LEDGER",
    "slug": "ledger",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ledger",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080b10",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080b10"
    },
    "assetBundlePatterns": [
      "assets/game/*"
    ],
    "ios": {
      "bundleIdentifier": "com.ledger.game",
      "buildNumber": "1",
      "supportsTablet": true,
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "com.ledger.game",
      "versionCode": 1,
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080b10"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "gameAsset": "assets/game/index.html",
      "webUrl": "https://ledger.example.com/"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
